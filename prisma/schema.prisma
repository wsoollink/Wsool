// Wsool database schema. See CLAUDE.md section 10.
// Every table has Row Level Security enabled (see the rls migration).
// The app reaches the database only from the server through Prisma, and every
// query on creator data is scoped to the signed-in user (CLAUDE.md section 12).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // One SQL query per read, nested relations included (default "join"): each extra query is a
  // network round trip to Supabase.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum Lang {
  ar
  en
}

enum Template {
  white
  black
  sand
  pink
  black_gold
  vivid
  green
  custom
}

/// How the creator's photo is shown: full-width square fading into the page, or a circle.
enum PhotoShape {
  full
  circle
}

/// Look of the social icons row on the creator page (Appearance): brand-colour squares,
/// solid circles in the template's text colour (default), or outline glyphs.
enum IconStyle {
  color
  solid
  outline
}

enum Plan {
  free
  pro
}

enum BillingCycle {
  monthly
  yearly
}

enum Currency {
  SAR
  USD
}

/// Currencies a creator can show their ad rates in (subscriptions stay SAR/USD).
enum RateCurrency {
  SAR
  USD
  AED
  KWD
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  expired
}

/// One row per Supabase Auth user. `id` equals auth.users.id.
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  /// Set by staff to suspend the account (page hidden, dashboard read-only).
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz

  page                 Page?
  subscription         Subscription?
  notifications        Notification[]
  notificationSettings NotificationSettings?
  cancellationFeedback CancellationFeedback[]
  aiReads              AiRead[]

  /// Affiliate program: the creator whose referral link this user signed up through (set once, on sign-up).
  referredById      String?              @map("referred_by") @db.Uuid
  referredAt        DateTime?            @map("referred_at") @db.Timestamptz
  referredBy        User?                @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         User[]               @relation("Referrals")
  referralAccount   ReferralAccount?
  commissionsEarned ReferralCommission[] @relation("CommissionReferrer")
  commissionsFrom   ReferralCommission[] @relation("CommissionReferred")
  referralClicks    ReferralClick[]
  referralPayouts   ReferralPayout[]
  pushTokens        PushToken[]
  agencyMemberships AgencyMember[]

  @@index([referredById])
  @@map("users")
}

/// The creator's public page at wsool.link/<username>.
model Page {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String     @unique @map("user_id") @db.Uuid
  /// Always lowercase (checked in the database); unique, so case-insensitive.
  username          String     @unique @db.VarChar(20)
  usernameChangedAt DateTime?  @map("username_changed_at") @db.Timestamptz
  primaryLang       Lang       @default(ar) @map("primary_lang")
  enEnabled         Boolean    @default(false) @map("en_enabled")
  template          Template   @default(white)
  /// Custom template: { colors: string[1..2], mode: "light" | "dark" }
  customColors      Json?      @map("custom_colors")
  accent            String?    @db.VarChar(7)
  photoShape        PhotoShape @default(full) @map("photo_shape")
  iconStyle         IconStyle  @default(solid) @map("icon_style")
  hideBranding      Boolean    @default(false) @map("hide_branding")
  /// Public page sections the creator hid (owner, Oct 2026): numbers | brands | works | rates. Data is kept.
  hiddenSections    String[]   @default([]) @map("hidden_sections")
  /// Sections shown only in the private view (owner, Nov 2026, Pro): opened with the page password or a private link.
  privateSections   String[]   @default([]) @map("private_sections")
  /// Whole page private: visitors see the photo, name and specialty only until they unlock it.
  lockWhole         Boolean    @default(false) @map("lock_whole")
  /// scrypt hash of the private-view password ("salt:hash"); null = no password (private links still work).
  privatePassword   String?    @map("private_password")
  /// Bumped when the password changes or is removed: earlier unlocks stop working.
  privateVersion    Int        @default(1) @map("private_version")
  /// Listed in the Wsool creator directory for companies (owner, Nov 2026; creator opts in, all plans).
  inDirectory       Boolean    @default(false) @map("in_directory")
  /// Free text block in "Links & services" (owner, Oct 2026): a short title + up to 300 characters, shown before My services.
  noteTitle         String?    @map("note_title") @db.VarChar(40)
  noteBody          String?    @map("note_body") @db.VarChar(300)
  noteTitleEn       String?    @map("note_title_en") @db.VarChar(40)
  noteBodyEn        String?    @map("note_body_en") @db.VarChar(300)
  /// Square hero photo (Supabase Storage URL).
  photoUrl          String?    @map("photo_url")
  /// Brand logo shown in the PDF media kit only.
  logoUrl           String?    @map("logo_url")
  /// WhatsApp number in international format, digits only (e.g. 9665XXXXXXXX).
  whatsapp          String?    @db.VarChar(20)
  contactEmail      String?    @map("contact_email") @db.VarChar(254)
  /// Show/hide each contact on the public page while keeping the value.
  whatsappVisible   Boolean    @default(true) @map("whatsapp_visible")
  emailVisible      Boolean    @default(true) @map("email_visible")
  isPublished       Boolean    @default(false) @map("is_published")
  /// Set when the creator deletes the account (30-day undo window).
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  translations   PageTranslation[]
  tags           Tag[]
  licenses       License[]
  socialAccounts SocialAccount[]
  monthlyViews   MonthlyView[]
  brandLogos     BrandLogo[]
  portfolioItems PortfolioItem[]
  rateSettings   RateSettings?
  rateBundles    RateBundle[]
  links          PageLink[]
  services       Service[]
  coupons        Coupon[]
  categories     PageCategory[]
  oldUsernames   UsernameRedirect[]
  pageViews      PageView[]
  contactClicks  ContactClick[]
  agencyLinks    AgencyLink[]
  privateLinks   PrivateLink[]
  directoryStats DirectoryStat[]

  @@map("pages")
}

/// Creator-written text per language. No auto-translation.
model PageTranslation {
  id        String @id @default(uuid()) @db.Uuid
  pageId    String @map("page_id") @db.Uuid
  lang      Lang
  fullName  String @default("") @map("full_name") @db.VarChar(80)
  specialty String @default("") @db.VarChar(80)
  bio       String @default("") @db.VarChar(500)
  city      String @default("") @db.VarChar(60)
  country   String @default("") @db.VarChar(60)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, lang])
  @@map("page_translations")
}

/// Extra names blocked from being claimed (site routes live in code too).
model ReservedUsername {
  name      String   @id @db.VarChar(20)
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("reserved_usernames")
}

/// One subscription row per user. New accounts start a 14-day Pro trial.
model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @unique @map("user_id") @db.Uuid
  plan                   Plan               @default(pro)
  status                 SubscriptionStatus @default(trialing)
  cycle                  BillingCycle?
  currency               Currency?
  trialEndsAt            DateTime?          @map("trial_ends_at") @db.Timestamptz
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz
  provider               String?
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @map("provider_subscription_id")
  /// Saved card/token at the provider, charged for renewals (never card numbers).
  paymentToken           String?            @map("payment_token")
  /// Short card description for the UI, e.g. "mada •••• 4242".
  paymentMethodLabel     String?            @map("payment_method_label") @db.VarChar(60)
  /// The creator turned off auto-renew: stays Pro until current_period_end.
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  /// Failed renewal attempts in a row (past_due); reset on success.
  failedAttempts         Int                @default(0) @map("failed_attempts")
  nextRetryAt            DateTime?          @map("next_retry_at") @db.Timestamptz
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@map("subscriptions")
}

enum Platform {
  tiktok
  instagram
  x
  youtube
  snapchat
  threads
  telegram
  facebook
  linkedin
  pinterest
  twitch
  jaco
  discord
  spotify
}

/// "expiring soon" is derived from verifiedUntil, not stored.
enum VerificationStatus {
  none
  in_review
  verified
  rejected
}

/// Short labels under the bio (max 18 chars, written per language).
model Tag {
  id     String @id @default(uuid()) @db.Uuid
  pageId String @map("page_id") @db.Uuid
  lang   Lang
  label  String @db.VarChar(18)
  sort   Int    @default(0)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, lang, sort])
  @@map("tags")
}

/// Free-form licenses, e.g. "رخصة موثوق" + number + optional file.
model License {
  id                 String             @id @default(uuid()) @db.Uuid
  pageId             String             @map("page_id") @db.Uuid
  name               String             @db.VarChar(60)
  nameEn             String?            @map("name_en") @db.VarChar(60)
  number             String             @db.VarChar(60)
  fileUrl            String?            @map("file_url")
  sort               Int                @default(0)
  /// Staff check of the license file (owner decision, Oct 2026). Editing the license resets it.
  verificationStatus VerificationStatus @default(none) @map("verification_status")
  rejectReason       String?            @map("reject_reason") @db.VarChar(40)
  submittedAt        DateTime?          @map("submitted_at") @db.Timestamptz
  reviewedAt         DateTime?          @map("reviewed_at") @db.Timestamptz
  reviewedBy         String?            @map("reviewed_by") @db.Uuid

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sort])
  @@index([verificationStatus])
  @@map("licenses")
}

model SocialAccount {
  id                 String             @id @default(uuid()) @db.Uuid
  pageId             String             @map("page_id") @db.Uuid
  platform           Platform
  handle             String             @db.VarChar(60)
  url                String
  followers          Int                @default(0)
  followersUpdatedAt DateTime?          @map("followers_updated_at") @db.Timestamptz
  verificationStatus VerificationStatus @default(none) @map("verification_status")
  verifiedUntil      DateTime?          @map("verified_until") @db.Timestamptz
  sort               Int                @default(0)
  /// Last "Connect" tap for a bot-linked platform (Telegram); the bot links only accounts that asked recently.
  connectRequestedAt DateTime?          @map("connect_requested_at") @db.Timestamptz

  page                 Page                  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  audience             AudienceData?
  rates                Rate[]
  bundles              BundlePlatform[]
  verificationRequests VerificationRequest[]
  connection           PlatformConnection?

  @@index([pageId, sort])
  @@map("social_accounts")
}

enum ConnectionStatus {
  active
  /// The platform refused the saved token (revoked, password change…): the creator must connect again.
  error

  @@map("connection_status")
}

/// A creator's own platform account linked through the platform's sign-in (OAuth): followers and audience
/// update by themselves, and the account counts as verified while linked. Server only; the refresh token is
/// encrypted (src/lib/token-box.ts).
model PlatformConnection {
  id           String           @id @default(uuid()) @db.Uuid
  accountId    String           @unique @map("account_id") @db.Uuid
  platform     Platform
  /// The platform's id for the account (YouTube channel id); one Wsool page per platform account.
  externalId   String           @map("external_id") @db.VarChar(100)
  externalName String?          @map("external_name") @db.VarChar(200)
  refreshToken String           @map("refresh_token")
  scopes       String           @default("")
  status       ConnectionStatus @default(active)
  lastSyncAt   DateTime?        @map("last_sync_at") @db.Timestamptz
  lastError    String?          @map("last_error") @db.VarChar(200)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz

  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([platform, externalId])
  @@index([status, lastSyncAt])
  @@map("platform_connections")
}

/// Audience breakdown shown in the platform pop-up. Each field is a list of
/// { label, percent } entries.
model AudienceData {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @unique @map("account_id") @db.Uuid
  gender    Json?
  ages      Json?
  countries Json?
  cities    Json?
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("audience_data")
}

model MonthlyView {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  /// First day of the month.
  month     DateTime @db.Date
  /// Total across platforms (what the public page shows).
  views     BigInt
  /// Views per account: { "<socialAccountId>": number }. Null for totals typed before the per-platform form.
  byAccount Json?    @map("by_account")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, month])
  @@map("monthly_views")
}

model BrandLogo {
  id      String @id @default(uuid()) @db.Uuid
  pageId  String @map("page_id") @db.Uuid
  name    String @db.VarChar(60)
  logoUrl String @map("logo_url")
  sort    Int    @default(0)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sort])
  @@map("brand_logos")
}

/// Past work: a portrait video with brand/type text per language.
model PortfolioItem {
  id       String    @id @default(uuid()) @db.Uuid
  pageId   String    @map("page_id") @db.Uuid
  platform Platform?
  /// Uploaded portrait video (MP4). Null when the work is a link instead.
  videoUrl String?   @map("video_url")
  /// TikTok / Instagram / YouTube post link (canonical, see src/lib/work-link.ts). Null for uploaded videos.
  linkUrl  String?   @map("link_url")
  thumbUrl String?   @map("thumb_url")
  sort     Int       @default(0)

  page         Page                       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  translations PortfolioItemTranslation[]

  @@index([pageId, sort])
  @@map("portfolio_items")
}

model PortfolioItemTranslation {
  id     String @id @default(uuid()) @db.Uuid
  itemId String @map("item_id") @db.Uuid
  lang   Lang
  brand  String @default("") @db.VarChar(60)
  type   String @default("") @db.VarChar(60)

  item PortfolioItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, lang])
  @@map("portfolio_item_translations")
}

model RateSettings {
  pageId      String       @id @map("page_id") @db.Uuid
  showOnPage  Boolean      @default(true) @map("show_on_page")
  showInPdf   Boolean      @default(true) @map("show_in_pdf")
  currency    RateCurrency @default(SAR)
  vatIncluded Boolean      @default(true) @map("vat_included")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("rate_settings")
}

/// "My links": a course, a store, a location… shown as cards on the page (before Contact).
/// `title` is in the page's primary language; `titleEn` is the English title of an Arabic page.
model PageLink {
  id       String  @id @default(uuid()) @db.Uuid
  pageId   String  @map("page_id") @db.Uuid
  title    String  @db.VarChar(60)
  titleEn  String? @map("title_en") @db.VarChar(60)
  url      String  @db.VarChar(500)
  /// Optional square image (Supabase Storage URL); without it an icon is picked from the link.
  imageUrl String? @map("image_url")
  sort     Int     @default(0)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sort])
  @@map("page_links")
}

/// "Discount coupons" (owner, Oct 2026): a store's code + the creator's tracking link, shown after "My links".
model Coupon {
  id            String    @id @default(uuid()) @db.Uuid
  pageId        String    @map("page_id") @db.Uuid
  store         String    @db.VarChar(40)
  storeEn       String?   @map("store_en") @db.VarChar(40)
  /// e.g. "10% off everything".
  description   String    @default("") @db.VarChar(120)
  descriptionEn String?   @map("description_en") @db.VarChar(120)
  code          String    @db.VarChar(30)
  /// The creator's tracking link (https).
  url           String    @db.VarChar(500)
  /// Store logo (Supabase Storage URL), uploaded by the creator.
  logoUrl       String?   @map("logo_url")
  /// Last day the coupon shows (inclusive, Saudi time); null = no end.
  expiresOn     DateTime? @map("expires_on") @db.Date
  sort          Int       @default(0)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sort])
  @@map("coupons")
}

/// "My services" (photography, hosting events…), shown after the ad rates. No price = "on request".
model Service {
  id            String   @id @default(uuid()) @db.Uuid
  pageId        String   @map("page_id") @db.Uuid
  name          String   @db.VarChar(60)
  nameEn        String?  @map("name_en") @db.VarChar(60)
  description   String   @default("") @db.VarChar(300)
  descriptionEn String?  @map("description_en") @db.VarChar(300)
  price         Decimal? @db.Decimal(12, 2)
  /// e.g. "per hour", "per project".
  unit          String   @default("") @db.VarChar(30)
  unitEn        String?  @map("unit_en") @db.VarChar(30)
  sort          Int      @default(0)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sort])
  @@map("services")
}

/// A rate type the creator defines for one platform account (e.g. "Story").
model Rate {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  name      String  @db.VarChar(40)
  nameEn    String? @map("name_en") @db.VarChar(40)
  price     Decimal @db.Decimal(12, 2)
  sort      Int     @default(0)

  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, sort])
  @@map("rates")
}

/// Optional bundle across platforms with its own rate types.
model RateBundle {
  id     String  @id @default(uuid()) @db.Uuid
  pageId String  @map("page_id") @db.Uuid
  name   String? @db.VarChar(40)
  nameEn String? @map("name_en") @db.VarChar(40)
  sort   Int     @default(0)

  page      Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  platforms BundlePlatform[]
  rates     BundleRate[]

  @@index([pageId, sort])
  @@map("rate_bundles")
}

model BundlePlatform {
  bundleId  String @map("bundle_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid

  bundle  RateBundle    @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([bundleId, accountId])
  @@map("bundle_platforms")
}

model BundleRate {
  id       String  @id @default(uuid()) @db.Uuid
  bundleId String  @map("bundle_id") @db.Uuid
  name     String  @db.VarChar(40)
  nameEn   String? @map("name_en") @db.VarChar(40)
  price    Decimal @db.Decimal(12, 2)
  sort     Int     @default(0)

  bundle RateBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([bundleId, sort])
  @@map("bundle_rates")
}

enum RequestStatus {
  pending
  approved
  rejected
  /// The creator changed the account (or sent a new screenshot) before review.
  cancelled
}

/// A creator's request to verify one account (CLAUDE.md section 7).
model VerificationRequest {
  id             String        @id @default(uuid()) @db.Uuid
  accountId      String        @map("account_id") @db.Uuid
  /// Private storage path (bucket "verification").
  screenshotPath String        @map("screenshot_path")
  /// Snapshot of what was submitted, so staff review exactly that.
  platform       Platform
  handle         String        @db.VarChar(60)
  followers      Int
  status         RequestStatus @default(pending)
  /// Preset rejection reason key (src/config/verification.ts).
  reason         String?       @db.VarChar(40)
  reviewedBy     String?       @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?     @map("reviewed_at") @db.Timestamptz
  /// What the AI read from the screenshot (src/lib/ai/screenshots.ts), shown to staff. Null = not read.
  aiResult       Json?         @map("ai_result")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([accountId, createdAt])
  @@map("verification_requests")
}

enum AdminRole {
  owner
  verifier
  support
  finance
  custom
}

/// Wsool staff. The owner comes from OWNER_EMAIL; members are invited by email
/// and linked to their user id on their first visit to /admin.
model AdminMember {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique
  userId      String?   @unique @map("user_id") @db.Uuid
  role        AdminRole
  /// Permission keys (src/config/admin.ts) for non-owner members.
  permissions Json      @default("[]")
  active      Boolean   @default(true)
  invitedBy   String?   @map("invited_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("admin_members")
}

/// Every admin action: who, what, when (CLAUDE.md section 9).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  actorEmail String   @map("actor_email")
  action     String   @db.VarChar(60)
  targetType String?  @map("target_type") @db.VarChar(30)
  targetId   String?  @map("target_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_log")
}

enum InvoiceStatus {
  /// Checkout started, not paid yet.
  pending
  paid
  failed
  refunded
}

enum InvoiceKind {
  /// First payment (from trial/free) or a plan change.
  checkout
  renewal
}

/// One payment attempt and, once paid, the invoice for it. Prices include VAT.
model Invoice {
  id                String        @id @default(uuid()) @db.Uuid
  /// Sequential number, assigned when paid (e.g. 1042 -> "WS-001042").
  number            Int?          @unique
  /// Who paid: the creator, or the agency member who started the checkout.
  userId            String        @map("user_id") @db.Uuid
  /// A creator's Pro invoice (null for an agency plan invoice).
  subscriptionId    String?       @map("subscription_id") @db.Uuid
  /// An agency plan invoice (owner, Nov 2026); exactly one of subscription_id / agency_id is set.
  agencyId          String?       @map("agency_id") @db.Uuid
  agencyPlan        AgencyPlan?   @map("agency_plan")
  kind              InvoiceKind
  status            InvoiceStatus @default(pending)
  cycle             BillingCycle
  currency          Currency
  /// Total paid, VAT included.
  amount            Decimal       @db.Decimal(10, 2)
  vatAmount         Decimal       @map("vat_amount") @db.Decimal(10, 2)
  periodStart       DateTime?     @map("period_start") @db.Timestamptz
  periodEnd         DateTime?     @map("period_end") @db.Timestamptz
  provider          String        @db.VarChar(20)
  providerPaymentId String?       @unique @map("provider_payment_id")
  failureReason     String?       @map("failure_reason") @db.VarChar(200)
  /// Discount code used on this (first) payment; amount is already after the discount.
  discountCodeId    String?       @map("discount_code_id") @db.Uuid
  discountAmount    Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  /// Paid from the creator's affiliate credit (renewals); `amount` is the full price, the provider charged amount - credit.
  creditAmount      Decimal       @default(0) @map("credit_amount") @db.Decimal(10, 2)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz
  refundedAt        DateTime?     @map("refunded_at") @db.Timestamptz
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// SetNull: a deleted agency's paid invoices stay (tax records).
  agency       Agency?       @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([agencyId, createdAt])
  @@index([status, paidAt])
  @@map("invoices")
}

/// One visit to a public creator page. No IP or user agent is stored: the
/// visitor hash (daily salt) only counts unique visitors per day.
model PageView {
  id          BigInt   @id @default(autoincrement())
  pageId      String   @map("page_id") @db.Uuid
  day         DateTime @db.Date
  visitorHash String   @map("visitor_hash") @db.VarChar(32)
  /// ISO country code from the CDN, when known.
  country     String?  @db.VarChar(2)
  /// Host of the referring site (instagram.com, t.co, ...), when known.
  referrer    String?  @db.VarChar(100)
  device      String   @db.VarChar(10)
  lang        Lang
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, day])
  @@index([pageId, visitorHash, day])
  @@map("page_views")
}

enum ClickKind {
  whatsapp
  email
  social
  work
  /// A "My links" card; target_id = the link.
  link
  /// "Request this service"; target_id = the service.
  service
  /// Coupon code copied; target_id = the coupon.
  coupon_copy
  /// Coupon "Shop now" link; target_id = the coupon.
  coupon_open
}

/// A tap on a contact button, social icon or past work on a public page.
model ContactClick {
  id          BigInt    @id @default(autoincrement())
  pageId      String    @map("page_id") @db.Uuid
  day         DateTime  @db.Date
  kind        ClickKind
  /// Platform for social icons and works.
  platform    Platform?
  /// The link, service or coupon tapped (kinds link / service / coupon_*).
  targetId    String?   @map("target_id") @db.Uuid
  visitorHash String    @map("visitor_hash") @db.VarChar(32)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, day])
  @@map("contact_clicks")
}

/// In-app notification (the bell). Most are also sent by email.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Notification type key (src/lib/notify.ts).
  type      String    @db.VarChar(40)
  data      Json      @default("{}")
  /// Prevents sending the same reminder twice (e.g. "trial_day10").
  dedupeKey String?   @map("dedupe_key") @db.VarChar(100)
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Which optional emails a creator gets. Account, billing and verification
/// emails are always sent.
model NotificationSettings {
  userId           String  @id @map("user_id") @db.Uuid
  emailReminders   Boolean @default(true) @map("email_reminders")
  emailProductNews Boolean @default(true) @map("email_product_news")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

enum ExpenseCategory {
  hosting
  software
  marketing
  salaries
  payment_fees
  legal
  other
}

enum Recurrence {
  none
  monthly
  yearly
}

/// Company expense entered by staff (Finance). Recurring ones repeat from
/// `date` every month/year until `endDate` (or forever).
model Expense {
  id          String          @id @default(uuid()) @db.Uuid
  date        DateTime        @db.Date
  endDate     DateTime?       @map("end_date") @db.Date
  amount      Decimal         @db.Decimal(12, 2)
  currency    Currency
  category    ExpenseCategory
  recurrence  Recurrence      @default(none)
  description String          @default("") @db.VarChar(200)
  createdBy   String          @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@index([date])
  @@map("expenses")
}

/// Read-only link for investors: chosen sections and period, expiry,
/// optional password. Only a hash of the token is stored.
model InvestorLink {
  id           String    @id @default(uuid()) @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  label        String    @db.VarChar(80)
  sections     Json
  months       Int
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  passwordHash String?   @map("password_hash")
  createdBy    String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  lastViewedAt DateTime? @map("last_viewed_at") @db.Timestamptz
  views        Int       @default(0)

  @@map("investor_links")
}

enum NewsletterStatus {
  /// Signed up, confirmation email sent, not confirmed yet.
  pending
  confirmed
  unsubscribed
}

/// Marketing newsletter (double opt-in). Confirm/unsubscribe links carry an
/// HMAC of the row id, so no token is stored.
model NewsletterSubscriber {
  id             String           @id @default(uuid()) @db.Uuid
  email          String           @unique
  lang           Lang
  status         NewsletterStatus @default(pending)
  /// Where they signed up (e.g. "home", "pricing").
  source         String           @default("home") @db.VarChar(40)
  confirmSentAt  DateTime?        @map("confirm_sent_at") @db.Timestamptz
  confirmedAt    DateTime?        @map("confirmed_at") @db.Timestamptz
  unsubscribedAt DateTime?        @map("unsubscribed_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  /// List membership (owner, Nov 2026): true = on the list, false = left it (never re-added automatically),
  /// null = never on it. Creators' and agency members' account emails are added automatically (syncLists).
  creators       Boolean?
  agencies       Boolean?

  deliveries NewsletterDelivery[]

  @@index([status])
  @@map("newsletter_subscribers")
}

enum NewsletterAudience {
  creators
  agencies
  all
}

enum CampaignStatus {
  draft
  /// Sending started; batches go out until every confirmed subscriber has a delivery row.
  sending
  sent
}

/// One newsletter issue written in the admin panel. Subscribers get their
/// language's version, or the other one when theirs is empty.
enum EmailFont {
  wsool
  system

  @@map("email_font")
}

model NewsletterCampaign {
  id          String             @id @default(uuid()) @db.Uuid
  subjectAr   String             @default("") @map("subject_ar") @db.VarChar(150)
  bodyAr      String             @default("") @map("body_ar")
  subjectEn   String             @default("") @map("subject_en") @db.VarChar(150)
  bodyEn      String             @default("") @map("body_en")
  /// Optional button under the text.
  ctaLabelAr  String             @default("") @map("cta_label_ar") @db.VarChar(40)
  ctaLabelEn  String             @default("") @map("cta_label_en") @db.VarChar(40)
  ctaUrl      String             @default("") @map("cta_url") @db.VarChar(500)
  /// Font of the title and headings: Wsool's (Noto Kufi Arabic, where the mail app allows web fonts) or the system font.
  headingFont EmailFont          @default(wsool) @map("heading_font")
  /// Who gets it: the creators list, the agencies list, or both (each address once).
  audience    NewsletterAudience @default(creators)
  status      CampaignStatus     @default(draft)
  createdBy   String             @map("created_by") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  startedAt   DateTime?          @map("started_at") @db.Timestamptz
  sentAt      DateTime?          @map("sent_at") @db.Timestamptz
  sentCount   Int                @default(0) @map("sent_count")
  failedCount Int                @default(0) @map("failed_count")

  deliveries NewsletterDelivery[]

  @@index([createdAt])
  @@map("newsletter_campaigns")
}

/// Who a campaign went to. The row is written before sending, so a resumed
/// send never emails the same subscriber twice.
model NewsletterDelivery {
  campaignId   String   @map("campaign_id") @db.Uuid
  subscriberId String   @map("subscriber_id") @db.Uuid
  /// sending | sent | failed
  status       String   @default("sending") @db.VarChar(10)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  campaign   NewsletterCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@id([campaignId, subscriberId])
  @@index([subscriberId])
  @@map("newsletter_deliveries")
}

/// Answer to "why are you cancelling?" when a creator turns off auto-renew.
model CancellationFeedback {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// One of CANCEL_REASONS (src/config/plans.ts).
  reason    String   @db.VarChar(30)
  note      String?  @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("cancellation_feedback")
}

/// One-time discount code made by staff: a percentage off the first payment
/// (monthly or yearly), valid for 30 days, optionally only for one email.
model DiscountCode {
  id        String        @id @default(uuid()) @db.Uuid
  /// "WSL-7KQ2M9", stored uppercase.
  code      String        @unique @db.VarChar(20)
  /// 5-90 = off the first payment; 100 = a free Pro period (`freeCycle`), no payment at all.
  percent   Int
  /// For 100% codes: how long the free Pro lasts (one month or one year).
  freeCycle BillingCycle? @map("free_cycle")
  /// Only this account email can use it (lowercase); null = whoever enters it first.
  email     String?       @db.VarChar(254)
  /// Who it's for (name, campaign…), staff only.
  note      String        @default("") @db.VarChar(120)
  createdBy String        @map("created_by") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime      @map("expires_at") @db.Timestamptz
  revokedAt DateTime?     @map("revoked_at") @db.Timestamptz
  usedAt    DateTime?     @map("used_at") @db.Timestamptz
  usedBy    String?       @map("used_by") @db.Uuid
  invoiceId String?       @unique @map("invoice_id") @db.Uuid

  @@index([createdAt])
  @@map("discount_codes")
}

/// Creator categories (cooking, travel, ...) managed by the owner in the admin panel.
/// Creators pick up to MAX_PAGE_CATEGORIES; used for staff insights and filters.
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  nameAr    String   @map("name_ar") @db.VarChar(40)
  nameEn    String   @map("name_en") @db.VarChar(40)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  pages PageCategory[]

  @@map("categories")
}

model PageCategory {
  pageId     String @map("page_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  page     Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([pageId, categoryId])
  @@index([categoryId])
  @@map("page_categories")
}

enum AiReadKind {
  account
  audience
}

/// One AI reading of a screenshot (account page for verification, or audience stats).
/// Also the daily limit per creator (AI_DAILY_LIMIT). Server only.
model AiRead {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  kind      AiReadKind
  /// Private storage path of the screenshot (account reads; audience images are deleted after reading).
  path      String?
  accountId String?    @map("account_id") @db.Uuid
  ok        Boolean
  result    Json?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_reads")
}

/// A username the creator changed away from: for 30 days it redirects to their page and nobody else
/// can claim it (stops impersonation through links already shared with brands). Server only.
model UsernameRedirect {
  /// The old username (lowercase).
  name       String   @id
  pageId     String   @map("page_id") @db.Uuid
  /// After this the name is free again and stops redirecting.
  releasedAt DateTime @map("released_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("username_redirects")
}

/// Fixed-window counters for abuse limits (login codes, newsletter sign-ups,
/// uploads, investor-link passwords, page tracking). Server only.
model RateLimit {
  key     String   @id @db.VarChar(200)
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz

  @@map("rate_limits")
}

/// Affiliate program (CLAUDE.md, owner Oct 2026): how a creator wants their commission paid.
/// Server only (IBAN), never exposed through the Data API.
model ReferralAccount {
  userId       String       @id @map("user_id") @db.Uuid
  payoutMethod PayoutMethod @default(credit) @map("payout_method")
  /// International bank account number, uppercase without spaces (bank payouts).
  iban         String?      @db.VarChar(34)
  holderName   String?      @map("holder_name") @db.VarChar(100)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referral_accounts")
}

enum PayoutMethod {
  /// Taken off the creator's next Wsool renewal.
  credit
  /// Bank transfer by the owner once the balance reaches the minimum.
  bank
}

/// One unique click on a creator's referral link per visitor and day (no IP stored).
model ReferralClick {
  id          BigInt   @id @default(autoincrement())
  referrerId  String   @map("referrer_id") @db.Uuid
  day         DateTime @db.Date
  visitorHash String   @map("visitor_hash") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  referrer User @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([referrerId, day, visitorHash])
  @@map("referral_clicks")
}

/// A commission on one paid invoice of a referred customer (amounts in SAR, before VAT).
model ReferralCommission {
  id             String    @id @default(uuid()) @db.Uuid
  referrerId     String    @map("referrer_id") @db.Uuid
  referredUserId String?   @map("referred_user_id") @db.Uuid
  invoiceId      String?   @unique @map("invoice_id") @db.Uuid
  /// Invoice amount without VAT, in SAR.
  baseAmount     Decimal   @map("base_amount") @db.Decimal(10, 2)
  /// Percent applied (REFERRAL.percent when earned).
  percent        Int
  amount         Decimal   @db.Decimal(10, 2)
  /// Payable from this date (hold period for refunds).
  availableAt    DateTime  @map("available_at") @db.Timestamptz
  /// The invoice was refunded during the hold period.
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  referrer     User  @relation("CommissionReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User? @relation("CommissionReferred", fields: [referredUserId], references: [id], onDelete: SetNull)

  @@index([referrerId, createdAt])
  @@map("referral_commissions")
}

/// Money paid out to a creator: a bank transfer (recorded by staff) or credit used on a renewal.
model ReferralPayout {
  id         String       @id @default(uuid()) @db.Uuid
  referrerId String       @map("referrer_id") @db.Uuid
  method     PayoutMethod
  amount     Decimal      @db.Decimal(10, 2)
  /// Bank: last 4 digits of the IBAN and the transfer reference. Credit: the renewal invoice id.
  note       String       @default("") @db.VarChar(200)
  invoiceId  String?      @map("invoice_id") @db.Uuid
  createdBy  String?      @map("created_by") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz

  referrer User @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId, createdAt])
  @@map("referral_payouts")
}

/// Mobile app: one row per installed device (Expo push token), so notifications also arrive as phone pushes.
model PushToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// "ExponentPushToken[...]"
  token      String   @unique @db.VarChar(200)
  platform   String   @db.VarChar(10)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

/// Marketing agency (owner, Nov 2026, phase 1): created by Wsool staff for the free beta. Server only.
model Agency {
  id                 String           @id @default(uuid()) @db.Uuid
  name               String           @db.VarChar(80)
  status             AgencyStatus     @default(active)
  /// agency = manages creators + directory; brand = a company that only searches the creator directory (owner, Nov 2026).
  kind               AgencyKind       @default(agency)
  /// Public agency page wsool.link/<slug> (owner, Nov 2026). Shares the username namespace with creator pages.
  slug               String?          @unique @db.VarChar(20)
  pagePublished      Boolean          @default(false) @map("page_published")
  nameEn             String?          @map("name_en") @db.VarChar(80)
  tagline            String?          @db.VarChar(100)
  taglineEn          String?          @map("tagline_en") @db.VarChar(100)
  bio                String?          @db.VarChar(800)
  bioEn              String?          @map("bio_en") @db.VarChar(800)
  city               String?          @db.VarChar(60)
  cityEn             String?          @map("city_en") @db.VarChar(60)
  logoUrl            String?          @map("logo_url")
  /// International digits, like pages.whatsapp.
  whatsapp           String?          @db.VarChar(15)
  email              String?          @db.VarChar(254)
  website            String?          @db.VarChar(200)
  template           AgencyTemplate   @default(executive)
  accent             String?          @db.VarChar(7)
  /// Agency plan (owner, Nov 2026): trial (free beta) until the owner sets a paid one in admin/agencies.
  plan               AgencyPlan       @default(trial)
  planCycle          BillingCycle?    @map("plan_cycle")
  /// Paid until (null = open-ended, e.g. the free beta).
  planUntil          DateTime?        @map("plan_until") @db.Timestamptz
  /// Online payment (owner, Nov 2026): currency of the paid plan, saved card token, auto-renew and renewal retries.
  planCurrency       Currency?        @map("plan_currency")
  paymentToken       String?          @map("payment_token")
  paymentMethodLabel String?          @map("payment_method_label") @db.VarChar(60)
  planAutoRenew      Boolean          @default(false) @map("plan_auto_renew")
  planFailedAttempts Int              @default(0) @map("plan_failed_attempts")
  planRetryAt        DateTime?        @map("plan_retry_at") @db.Timestamptz
  createdBy          String           @map("created_by") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  members            AgencyMember[]
  links              AgencyLink[]
  accounts           AgencyAccount[]
  brands             AgencyBrand[]
  activity           AgencyActivity[]
  invoices           Invoice[]

  @@map("agencies")
}

enum AgencyStatus {
  active
  inactive
}

enum AgencyKind {
  agency
  brand
}

/// Agency plans (src/config/agency-plans.ts): starter = up to 10 creators, growth = up to 30, custom = by agreement.
enum AgencyPlan {
  trial
  starter
  growth
  custom
}

/// Designs of the public agency page (src/components/agency-page/theme.ts).
enum AgencyTemplate {
  executive
  midnight
  graphite
  ivory
}

/// A person on the agency's team. Invited by email; linked to the account on first visit.
model AgencyMember {
  id        String     @id @default(uuid()) @db.Uuid
  agencyId  String     @map("agency_id") @db.Uuid
  agency    Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  /// Lowercase.
  email     String     @db.VarChar(254)
  userId    String?    @map("user_id") @db.Uuid
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AgencyRole @default(editor)
  invitedAt DateTime   @default(now()) @map("invited_at") @db.Timestamptz
  joinedAt  DateTime?  @map("joined_at") @db.Timestamptz

  @@unique([agencyId, email])
  @@index([email])
  @@index([userId])
  @@map("agency_members")
}

enum AgencyRole {
  owner
  manager
  editor
  viewer
}

/// An agency managing a creator's page, with the permissions the creator chose. The page always stays the creator's.
model AgencyLink {
  id           String     @id @default(uuid()) @db.Uuid
  agencyId     String     @map("agency_id") @db.Uuid
  agency       Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  pageId       String     @map("page_id") @db.Uuid
  page         Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  status       LinkStatus @default(pending)
  canContent   Boolean    @default(true) @map("can_content")
  canRates     Boolean    @default(true) @map("can_rates")
  canContact   Boolean    @default(false) @map("can_contact")
  invitedBy    String     @map("invited_by") @db.Uuid
  invitedAt    DateTime   @default(now()) @map("invited_at") @db.Timestamptz
  decidedAt    DateTime?  @map("decided_at") @db.Timestamptz
  endedAt      DateTime?  @map("ended_at") @db.Timestamptz
  /// "creator" (unlinked) or "agency" (removed the creator, or the agency was stopped).
  endedBy      String?    @map("ended_by") @db.VarChar(10)
  /// Listed on the agency's public page (on by default; the creator can turn it off, the agency can hide them too).
  showOnPage   Boolean    @default(true) @map("show_on_page")
  /// Hidden by the agency from its public page (the creator's own switch is showOnPage).
  agencyHidden Boolean    @default(false) @map("agency_hidden")
  /// Order on the agency page (smaller first).
  sort         Int        @default(0)

  @@index([pageId, status])
  @@index([agencyId, status])
  @@map("agency_links")
}

enum LinkStatus {
  pending
  active
  declined
  cancelled
  ended
}

/// What agency members changed on a creator's page (the creator sees it in their Agency section).
model AgencyActivity {
  id        String   @id @default(uuid()) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  pageId    String   @map("page_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  section   String   @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([pageId, createdAt])
  @@map("agency_activity")
}

/// A private link to the full page for one company (owner, Nov 2026): wsool.link/<username>?k=<token>. Only the token's SHA-256 is stored.
model PrivateLink {
  id           String    @id @default(uuid()) @db.Uuid
  pageId       String    @map("page_id") @db.Uuid
  /// Who it was made for (e.g. the brand's name), shown to the creator only.
  name         String    @db.VarChar(60)
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  /// The token sealed with TOKEN_ENCRYPTION_KEY, so the creator can copy the link again (null = shown once only).
  tokenSealed  String?   @map("token_sealed")
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  views        Int       @default(0)
  lastViewedAt DateTime? @map("last_viewed_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("private_links")
}

/// Creator directory counts per page and day (owner, Nov 2026): shown in search results, opened from the directory.
model DirectoryStat {
  pageId      String   @map("page_id") @db.Uuid
  day         DateTime @db.Date
  impressions Int      @default(0)
  opens       Int      @default(0)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([pageId, day])
  @@map("directory_stats")
}

/// "Join as an agency" requests from /agencies/apply (owner, Nov 2026). The owner opens the account from admin/agencies.
model AgencyRequest {
  id         String              @id @default(uuid()) @db.Uuid
  name       String              @db.VarChar(80)
  agencyName String              @map("agency_name") @db.VarChar(80)
  /// The email the agency account will be opened with (lowercase).
  email      String              @db.VarChar(254)
  /// International digits, e.g. 9665XXXXXXXX.
  phone      String              @db.VarChar(20)
  note       String?             @db.VarChar(1000)
  lang       Lang                @default(ar)
  status     AgencyRequestStatus @default(new)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz
  decidedAt  DateTime?           @map("decided_at") @db.Timestamptz

  @@index([status, createdAt])
  @@map("agency_requests")
}

enum AgencyRequestStatus {
  new
  opened
  declined
}

/// The agency's own social accounts (owner, Nov 2026), typed by the agency: shown on its public page and PDF.
model AgencyAccount {
  id        String   @id @default(uuid()) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  platform  Platform
  /// Username (or, for link platforms, the pasted link's path).
  handle    String   @db.VarChar(100)
  /// Built on the server from platform + handle (or the cleaned pasted link).
  url       String   @db.VarChar(300)
  followers Int      @default(0)
  sort      Int      @default(0)

  @@index([agencyId, sort])
  @@map("agency_accounts")
}

/// Brands the agency worked with (owner, Nov 2026): logos on its public page (scrolling strip) and PDF.
model AgencyBrand {
  id       String  @id @default(uuid()) @db.Uuid
  agencyId String  @map("agency_id") @db.Uuid
  agency   Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  logoUrl  String  @map("logo_url")
  name     String? @db.VarChar(60)
  sort     Int     @default(0)

  @@index([agencyId, sort])
  @@map("agency_brands")
}
