# Copy to .env.local and fill in. Never commit real values.

# Public site URL
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres (Prisma) — pooled connection for the app, direct connection for migrations
DATABASE_URL=
DIRECT_URL=

# Google sign-in (configured in Supabase Auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (transactional email from mail.wsool.link — before launch)
RESEND_API_KEY=
