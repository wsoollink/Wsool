# Copy to .env.local and fill in. Never commit real values.

# Public site URL
NEXT_PUBLIC_SITE_URL=

# Supabase (Settings > API Keys > "Publishable and secret API keys").
# The legacy anon / service_role keys are deprecated: don't use them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Postgres for Prisma (Dashboard > Connect).
# App: Transaction pooler (port 6543), add ?pgbouncer=true at the end.
DATABASE_URL=
# Migrations: Session pooler (port 5432). The "Direct connection" is IPv6-only.
DIRECT_URL=

# Admin panel owner: the email you sign in with (all permissions, can't be edited).
# Several owners: separate with commas.
OWNER_EMAIL=

# Payments: "mock" = test payments (team only, no real money). Empty = payments off.
# The real provider (moyasar or tap) is added when the owner opens an account.
PAYMENT_PROVIDER=
# Long random string; the hourly Netlify job sends it to /api/cron/billing.
CRON_SECRET=

# Google sign-in (configured in Supabase Auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (transactional email from mail.wsool.link — before launch)
RESEND_API_KEY=

# Anthropic (AI reading of verification and audience screenshots). Empty = feature off, manual flow.
ANTHROPIC_API_KEY=

# App Store / Google Play review sign-in (app only): one address + a fixed 8-10 digit code. Leave empty to turn off.
REVIEW_EMAIL=
REVIEW_CODE=

# Platform connections (src/lib/connect): encryption key for stored tokens = 32 random bytes in base64 (openssl rand -base64 32).
TOKEN_ENCRYPTION_KEY=
# YouTube: Google Cloud OAuth client (Web application), redirect URI https://wsool.link/api/connect/youtube/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# TikTok Login Kit (developers.tiktok.com app), redirect https://wsool.link/api/connect/tiktok/callback
# Instagram API with Instagram Login (Meta app → Instagram API → API setup with Instagram login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Threads API (Meta app → Use cases → Threads API → Settings)
THREADS_APP_ID=
THREADS_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Twitch (dev.twitch.tv console, Confidential client), redirect https://wsool.link/api/connect/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Discord (discord.com/developers app, OAuth2), redirect https://wsool.link/api/connect/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Telegram bot from @BotFather (channel subscribers; the webhook is set by the hourly job)
TELEGRAM_BOT_TOKEN=
# X (developer.x.com, OAuth 2.0 Web App, pay-per-use), redirect https://wsool.link/api/connect/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional cap on paid daily X updates (default 500)
X_DAILY_SYNC_LIMIT=
